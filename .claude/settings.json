{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch -a *)",
      "Bash(git branch -v *)",
      "Bash(git branch -vv *)",
      "Bash(python test_*)",
      "Bash(python3 test_*)"
    ],
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main)",
      "Bash(git push *:refs/heads/main *)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push -d *)",
      "Bash(git push * -d *)",
      "Bash(git push * :**)",
      "Bash(git push --tags*)",
      "Bash(git push * --tags*)",
      "Bash(git push --follow-tags*)",
      "Bash(git push * --follow-tags*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "Bash(git push --all*)",
      "Bash(git push * --all*)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "Bash(git branch * -d *)",
      "Bash(git branch * -D *)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "Bash(gh pr merge*)",
      "Bash(gh release *)",
      "Edit(.github/workflows/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.p8)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/db.json*)",
      "Read(**/*.bak)",
      "Bash(git push * beta)",
      "Bash(git push * beta *)",
      "Bash(git push *:beta)",
      "Bash(git push *:beta *)",
      "Bash(git push *:refs/heads/beta)",
      "Bash(git push *:refs/heads/beta *)",
      "Read(**/.lazo-pin)",
      "Read(**/clipboard-history.json)",
      "Read(nube/**)"
    ]
  }
}
